{
  "expo": {
    "name": "robigo",
   "slug": "robigo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "robigo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ROBIGO needs camera access to scan assessment papers.",
        "NSMicrophoneUsageDescription": "ROBIGO uses the microphone for voice commands.",
        "NSSpeechRecognitionUsageDescription": "ROBIGO uses speech recognition for voice commands."
      }
    },
    "android": {
  "package": "com.eshalsiraj890.robigo",
  "adaptiveIcon": {
    "backgroundColor": "#E6F4FE",
    "foregroundImage": "./assets/images/android-icon-foreground.png",
    "backgroundImage": "./assets/images/android-icon-background.png",
    "monochromeImage": "./assets/images/android-icon-monochrome.png"
  },
  "permissions": [
    "CAMERA",
    "RECORD_AUDIO"
  ],
  "predictiveBackGestureEnabled": false
},
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ROBIGO uses the microphone for voice commands.",
          "speechRecognitionPermission": "ROBIGO uses speech recognition for voice commands.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8493fa50-fc60-4cc6-9dfb-6eabf4894b0b"
      }
    },
    "owner": "eshalsiraj890"
  }
}
